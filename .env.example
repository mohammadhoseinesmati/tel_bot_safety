# توکن ربات که از @BotFather دریافت می‌کنید
BOT_TOKEN=123456789:AAExampleTokenReplaceThis

# شناسه عددی کاربری مالک/مالکین ربات (با کاما جدا کنید برای چند مالک)
# شناسه عددی خود را می‌توانید از @userinfobot دریافت کنید
OWNER_IDS=123456789

# (اختیاری) شناسه چت پشتیبانی؛ اگر خالی باشد پیام‌های پشتیبانی برای همه OWNER_IDS ارسال می‌شود
SUPPORT_CHAT_ID=

# آدرس دیتابیس (پیش‌فرض: sqlite)
DATABASE_URL=sqlite+aiosqlite:///bot.db
